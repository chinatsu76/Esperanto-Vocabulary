      ],
      "partOfSpeech": "名詞",
      "note": "名詞は原則として -o で終わります。",
      "example": {
        "eo": "libro estas libro.",
        "ja": "libro は『本』という名詞です。"
      },
      "relatedWords": [
        {
          "word": "libro",
          "meaning": "本"
        }
      ],
      "tips": {
        "origin": "",
        "japaneseHint": "語尾 -o を見れば、まず名詞と判断できます。",
        "morphology": ""
