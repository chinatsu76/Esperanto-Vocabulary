    {
      "word": "11・20・21・200・2000はどう組み立てる？",
      "meanings": [
        "dek unu / dudek / dudek unu / ducent / du mil"
      ],
      "partOfSpeech": "数詞",
      "note": "10台は dek + 1桁を分けて書く。20〜90と200〜900は十・百の前の数を続けて1語にする。千は分けて書く。",
      "example": {
        "eo": "11=dek unu / 20=dudek / 21=dudek unu / 200=ducent / 2000=du mil",
        "ja": "11 / 20 / 21 / 200 / 2000"
      },
      "relatedWords": [],
      "tips": {
        "rule": "十・百の倍数は dudek / ducent のように続ける。加算部分と mil は分ける。",
        "pitfall": "*dekdu、*dumil とは書かない。dek du、du mil。"
      },
      "id": 1092,
      "stage": 0,
      "unit": 1,
      "number": 92
    },
